{
  "parties": [
    { "id": "party-1", "name": "Hausleitung", "description": "Koordination und organisatorische Entscheidungen" },
    { "id": "party-2", "name": "Teamer", "description": "Betreuung und Kommunikation zwischen den Gruppen" },
    { "id": "party-3", "name": "Spaziergänger", "description": "Gruppe auf der gemeinsamen Route" },
    { "id": "party-4", "name": "Jugendleiter", "description": "Leitung des Jugendprogramms" },
    { "id": "party-5", "name": "Pärchen", "description": "Teilnehmende unterwegs im eigenen Programm" },
    { "id": "party-6", "name": "Im Haus geblieben", "description": "Gruppe und Ansprechpersonen im Haus" }
  ],
  "messages": [
    { "id": "m001", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "08:00", "text": "Bitte den Ablauf für die Gruppenaktivität vor zehn Uhr bestätigen.", "notes": "Tagesstart" },
    { "id": "m002", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "08:08", "text": "Der Ablauf steht; drei Stationen sind vorbereitet.", "notes": "" },
    { "id": "m003", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "08:16", "text": "Die Materialliste ist freigegeben.", "notes": "" },
    { "id": "m004", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "08:24", "text": "Wir starten mit der Begrüßung im Hauptraum.", "notes": "" },
    { "id": "m005", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "08:32", "text": "Bitte prüfe noch, ob alle Teilnehmenden erfasst sind.", "notes": "" },
    { "id": "m006", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "08:40", "text": "Die Anwesenheitsliste ist vollständig.", "notes": "" },
    { "id": "m007", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "08:48", "text": "Die Schlüssel für den Gruppenraum liegen am Empfang.", "notes": "" },
    { "id": "m008", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "08:56", "text": "Schlüssel sind abgeholt und der Raum ist vorbereitet.", "notes": "" },
    { "id": "m009", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "09:04", "text": "Im Erste-Hilfe-Kasten fehlt ein Kühlpack.", "notes": "Materialbedarf" },
    { "id": "m010", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "09:12", "text": "Ich ergänze ein Kühlpack aus dem Materiallager.", "notes": "" },
    { "id": "m011", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "09:20", "text": "Bitte gib den Spaziergängern die Wegkarte mit.", "notes": "" },
    { "id": "m012", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "09:28", "text": "Die Wegkarte wurde an die Gruppe übergeben.", "notes": "" },
    { "id": "m013", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "09:36", "text": "Der Start der Aktivität kann wie geplant erfolgen.", "notes": "" },
    { "id": "m014", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "09:44", "text": "Alle Gruppen sind pünktlich aufgebrochen.", "notes": "" },
    { "id": "m015", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "09:52", "text": "Melde dich, sobald die erste Gruppe den Aussichtspunkt erreicht.", "notes": "" },
    { "id": "m016", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "10:00", "text": "Die erste Gruppe ist am Aussichtspunkt und alle sind wohlauf.", "notes": "" },
    { "id": "m017", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "10:08", "text": "Danke, die Rückmeldung ist angekommen.", "notes": "" },
    { "id": "m018", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "10:16", "text": "Ich bleibe für Rückfragen am Haupteingang.", "notes": "" },
    { "id": "m019", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "10:24", "text": "Bitte die Regenwarnung für den Nachmittag beachten.", "notes": "Wetter" },
    { "id": "m020", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "10:32", "text": "Regenjacken sind verteilt; wir passen die Route bei Bedarf an.", "notes": "" },
    { "id": "m021", "from": "party-2", "to": "party-4", "category": "schwarz", "timestamp": "10:40", "text": "Die Jugendgruppe ist bereit für die Schnitzeljagd.", "notes": "" },
    { "id": "m022", "from": "party-4", "to": "party-2", "category": "schwarz", "timestamp": "10:48", "text": "Ich teile die Jugendlichen in zwei Teams ein.", "notes": "" },
    { "id": "m023", "from": "party-2", "to": "party-4", "category": "schwarz", "timestamp": "10:56", "text": "Die Aufgaben liegen an den drei Kontrollpunkten.", "notes": "" },
    { "id": "m024", "from": "party-4", "to": "party-2", "category": "gruen", "timestamp": "11:04", "text": "Team Blau hat seine erste Station erreicht.", "notes": "" },
    { "id": "m025", "from": "party-2", "to": "party-4", "category": "rot", "timestamp": "11:12", "text": "Bitte nach jeder Station die Hinweiskarten einsammeln.", "notes": "" },
    { "id": "m026", "from": "party-4", "to": "party-2", "category": "gruen", "timestamp": "11:20", "text": "Die Karten sind eingesammelt; niemand fehlt.", "notes": "" },
    { "id": "m027", "from": "party-2", "to": "party-4", "category": "schwarz", "timestamp": "11:28", "text": "Die Pause findet wegen des Wetters im Vorraum statt.", "notes": "" },
    { "id": "m028", "from": "party-4", "to": "party-2", "category": "gruen", "timestamp": "11:36", "text": "Getränke stehen für beide Teams bereit.", "notes": "" },
    { "id": "m029", "from": "party-2", "to": "party-4", "category": "schwarz", "timestamp": "11:44", "text": "Wir starten die letzte Runde in fünf Minuten.", "notes": "" },
    { "id": "m030", "from": "party-4", "to": "party-2", "category": "gruen", "timestamp": "11:52", "text": "Die Gruppe ist zurück und die Materialien sind vollständig.", "notes": "" },
    { "id": "m031", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "12:00", "text": "Wie viele Personen gehen direkt zum Mittagessen?", "notes": "" },
    { "id": "m032", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "12:08", "text": "Zwölf Personen kommen aus dem Garten; vier helfen noch beim Aufbau.", "notes": "" },
    { "id": "m033", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "12:16", "text": "Bitte einen Platz für die später zurückkehrende Gruppe freihalten.", "notes": "" },
    { "id": "m034", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "12:24", "text": "Ein Tisch ist reserviert und deutlich markiert.", "notes": "" },
    { "id": "m035", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "12:32", "text": "Die Küche verschiebt die Ausgabe um zehn Minuten.", "notes": "" },
    { "id": "m036", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "12:40", "text": "Ich gebe die Änderung an alle Gruppen weiter.", "notes": "" },
    { "id": "m037", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "12:48", "text": "Die Rückkehr der Spaziergänger verzögert sich.", "notes": "" },
    { "id": "m038", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "12:56", "text": "Wir warten am Eingang und prüfen die Route.", "notes": "" },
    { "id": "m039", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "13:04", "text": "Die Gruppe ist unterwegs; danke für die Koordination.", "notes": "" },
    { "id": "m040", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "13:12", "text": "Alle sind angekommen und niemand benötigt Unterstützung.", "notes": "" },
    { "id": "m041", "from": "party-3", "to": "party-2", "category": "schwarz", "timestamp": "13:20", "text": "Wir sind am Waldrand und folgen dem markierten Weg.", "notes": "" },
    { "id": "m042", "from": "party-2", "to": "party-3", "category": "schwarz", "timestamp": "13:28", "text": "Bestätigt. Der Rückweg führt an der alten Brücke vorbei.", "notes": "" },
    { "id": "m043", "from": "party-3", "to": "party-2", "category": "rot", "timestamp": "13:36", "text": "Ein Wegweiser ist umgekippt; wir nehmen den befestigten Pfad.", "notes": "Routenänderung" },
    { "id": "m044", "from": "party-2", "to": "party-3", "category": "gruen", "timestamp": "13:44", "text": "Gute Entscheidung. Bitte kurz die neue Ankunftszeit melden.", "notes": "" },
    { "id": "m045", "from": "party-3", "to": "party-2", "category": "schwarz", "timestamp": "13:52", "text": "Wir rechnen mit etwa zwanzig Minuten bis zum Haus.", "notes": "" },
    { "id": "m046", "from": "party-2", "to": "party-3", "category": "schwarz", "timestamp": "14:00", "text": "Am Eingang wartet jemand mit Wasser auf euch.", "notes": "" },
    { "id": "m047", "from": "party-3", "to": "party-2", "category": "gruen", "timestamp": "14:08", "text": "Die Brücke ist passiert, alle aus der Gruppe sind zusammen.", "notes": "" },
    { "id": "m048", "from": "party-2", "to": "party-3", "category": "gruen", "timestamp": "14:16", "text": "Wir haben euch gesehen; der Tisch ist schon vorbereitet.", "notes": "" },
    { "id": "m049", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "14:24", "text": "Bitte den Gruppenraum für die Nachbesprechung vorbereiten.", "notes": "" },
    { "id": "m050", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "14:32", "text": "Stühle stehen im Kreis; Papier und Stifte liegen bereit.", "notes": "" },
    { "id": "m051", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "14:40", "text": "Die Rückmeldungen zum Vormittag waren überwiegend positiv.", "notes": "" },
    { "id": "m052", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "14:48", "text": "Ich sammle die wichtigsten Beobachtungen auf einem Flipchart.", "notes": "" },
    { "id": "m053", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "14:56", "text": "Bitte bei der Nachbesprechung auch die Verzögerung ansprechen.", "notes": "" },
    { "id": "m054", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "15:04", "text": "Die Routenänderung und ihre Gründe sind dokumentiert.", "notes": "" },
    { "id": "m055", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "15:12", "text": "Die nächste Aktivität beginnt um halb vier im Innenhof.", "notes": "" },
    { "id": "m056", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "15:20", "text": "Alle Betreuenden haben den neuen Treffpunkt bestätigt.", "notes": "" },
    { "id": "m057", "from": "party-5", "to": "party-2", "category": "schwarz", "timestamp": "15:28", "text": "Wir würden gern später direkt zum Innenhof kommen.", "notes": "" },
    { "id": "m058", "from": "party-2", "to": "party-5", "category": "schwarz", "timestamp": "15:36", "text": "Das ist in Ordnung; gebt am Eingang kurz Bescheid.", "notes": "" },
    { "id": "m059", "from": "party-5", "to": "party-2", "category": "rot", "timestamp": "15:44", "text": "Der Bus hat Verspätung, wir kommen ungefähr zehn Minuten später.", "notes": "" },
    { "id": "m060", "from": "party-2", "to": "party-5", "category": "gruen", "timestamp": "15:52", "text": "Danke für die Nachricht; der Treffpunkt bleibt unverändert.", "notes": "" },
    { "id": "m061", "from": "party-5", "to": "party-2", "category": "schwarz", "timestamp": "16:00", "text": "Wir sind angekommen und gehen jetzt in den Innenhof.", "notes": "" },
    { "id": "m062", "from": "party-2", "to": "party-5", "category": "schwarz", "timestamp": "16:08", "text": "Die Gruppe sitzt links neben dem Brunnen.", "notes": "" },
    { "id": "m063", "from": "party-5", "to": "party-2", "category": "gruen", "timestamp": "16:16", "text": "Wir haben euch gefunden und machen bei der Runde mit.", "notes": "" },
    { "id": "m064", "from": "party-2", "to": "party-5", "category": "gruen", "timestamp": "16:24", "text": "Schön, dass ihr da seid; die nächste Station beginnt gleich.", "notes": "" },
    { "id": "m065", "from": "party-6", "to": "party-1", "category": "schwarz", "timestamp": "16:32", "text": "Im Haus ist es ruhig; der Aufenthaltsraum ist wieder frei.", "notes": "" },
    { "id": "m066", "from": "party-1", "to": "party-6", "category": "schwarz", "timestamp": "16:40", "text": "Danke. Bitte die Fenster im Gruppenraum kurz prüfen.", "notes": "" },
    { "id": "m067", "from": "party-6", "to": "party-1", "category": "rot", "timestamp": "16:48", "text": "Ein Fenster lässt sich nicht vollständig schließen.", "notes": "Hauszustand" },
    { "id": "m068", "from": "party-1", "to": "party-6", "category": "schwarz", "timestamp": "16:56", "text": "Ich kümmere mich nach der Aktivität darum.", "notes": "" },
    { "id": "m069", "from": "party-6", "to": "party-1", "category": "gruen", "timestamp": "17:04", "text": "Die Küche hat die Getränke für den Abend bereitgestellt.", "notes": "" },
    { "id": "m070", "from": "party-1", "to": "party-6", "category": "schwarz", "timestamp": "17:12", "text": "Bitte eine Kanne Wasser für die Rückkehrer stehen lassen.", "notes": "" },
    { "id": "m071", "from": "party-6", "to": "party-1", "category": "schwarz", "timestamp": "17:20", "text": "Wasser steht im Eingangsbereich bereit.", "notes": "" },
    { "id": "m072", "from": "party-1", "to": "party-6", "category": "gruen", "timestamp": "17:28", "text": "Alles klar, die Gruppen kehren nach und nach zurück.", "notes": "" },
    { "id": "m073", "from": "party-1", "to": "party-4", "category": "schwarz", "timestamp": "17:36", "text": "Wie lief die letzte Runde der Jugendgruppe?", "notes": "" },
    { "id": "m074", "from": "party-4", "to": "party-1", "category": "gruen", "timestamp": "17:44", "text": "Alle Stationen wurden geschafft; die Gruppe hatte viel Freude.", "notes": "" },
    { "id": "m075", "from": "party-1", "to": "party-4", "category": "rot", "timestamp": "17:52", "text": "Bitte kontrolliere vor dem Abendessen noch das Material.", "notes": "" },
    { "id": "m076", "from": "party-4", "to": "party-1", "category": "schwarz", "timestamp": "18:00", "text": "Material ist vollständig; eine Karte muss neu laminiert werden.", "notes": "" },
    { "id": "m077", "from": "party-1", "to": "party-4", "category": "schwarz", "timestamp": "18:08", "text": "Die Essensausgabe beginnt in zehn Minuten.", "notes": "" },
    { "id": "m078", "from": "party-4", "to": "party-1", "category": "schwarz", "timestamp": "18:16", "text": "Die Jugendlichen sind informiert und kommen geschlossen herunter.", "notes": "" },
    { "id": "m079", "from": "party-1", "to": "party-4", "category": "gruen", "timestamp": "18:24", "text": "Danke für die gute Abstimmung heute.", "notes": "" },
    { "id": "m080", "from": "party-4", "to": "party-1", "category": "schwarz", "timestamp": "18:32", "text": "Gern. Ich schicke später noch die kurze Auswertung.", "notes": "" },
    { "id": "m081", "from": "party-2", "to": "party-4", "category": "schwarz", "timestamp": "18:40", "text": "Kannst du beim Abendprogramm die Musik übernehmen?", "notes": "" },
    { "id": "m082", "from": "party-4", "to": "party-2", "category": "gruen", "timestamp": "18:48", "text": "Ja, die Lautsprecher sind angeschlossen und getestet.", "notes": "" },
    { "id": "m083", "from": "party-2", "to": "party-4", "category": "rot", "timestamp": "18:56", "text": "Bitte die Lautstärke ab halb zehn reduzieren.", "notes": "" },
    { "id": "m084", "from": "party-4", "to": "party-2", "category": "schwarz", "timestamp": "19:04", "text": "Verstanden; ich stelle mir eine Erinnerung.", "notes": "" },
    { "id": "m085", "from": "party-3", "to": "party-5", "category": "schwarz", "timestamp": "19:12", "text": "Wir treffen uns morgen wieder an der Weggabelung.", "notes": "" },
    { "id": "m086", "from": "party-3", "to": "party-5", "category": "gruen", "timestamp": "19:20", "text": "Die Runde heute war trotz des Wetters schön.", "notes": "" },
    { "id": "m087", "from": "party-5", "to": "party-3", "category": "schwarz", "timestamp": "19:28", "text": "Gern, wir bringen beim nächsten Mal eine Thermoskanne mit.", "notes": "" },
    { "id": "m088", "from": "party-6", "to": "party-2", "category": "rot", "timestamp": "19:36", "text": "Im Flur liegt noch eine vergessene Trinkflasche.", "notes": "" },
    { "id": "m089", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "19:44", "text": "Bitte die Rückmeldungen für die Tagesauswertung sammeln.", "notes": "Abschlussrunde" },
    { "id": "m090", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "19:52", "text": "Drei Gruppen haben bereits kurze Rückmeldungen abgegeben.", "notes": "" },
    { "id": "m091", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "20:00", "text": "Eine Rückmeldung zur Wegänderung fehlt noch.", "notes": "" },
    { "id": "m092", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "20:08", "text": "Ich frage die Spaziergänger direkt nach ihrer Einschätzung.", "notes": "" },
    { "id": "m093", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "20:16", "text": "Die Küche bestätigt, dass morgen früher geöffnet werden kann.", "notes": "" },
    { "id": "m094", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "20:24", "text": "Ich notiere den früheren Start für die Planung.", "notes": "" },
    { "id": "m095", "from": "party-1", "to": "party-2", "category": "schwarz", "timestamp": "20:32", "text": "Bitte den Gruppenraum nach dem Abendprogramm abschließen.", "notes": "" },
    { "id": "m096", "from": "party-2", "to": "party-1", "category": "gruen", "timestamp": "20:40", "text": "Der Raum ist aufgeräumt und abgeschlossen.", "notes": "" },
    { "id": "m097", "from": "party-1", "to": "party-2", "category": "rot", "timestamp": "20:48", "text": "Die Liste mit den Fundsachen liegt noch am Empfang.", "notes": "" },
    { "id": "m098", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "20:56", "text": "Ich bringe sie gleich ins Büro und beschrifte den Fund.", "notes": "" },
    { "id": "m099", "from": "party-1", "to": "party-2", "category": "gruen", "timestamp": "21:04", "text": "Danke. Für heute sind alle offenen Punkte geklärt.", "notes": "" },
    { "id": "m100", "from": "party-2", "to": "party-1", "category": "schwarz", "timestamp": "21:12", "text": "Verstanden, ich verabschiede die letzte Gruppe und beende den Dienst.", "notes": "" }
  ]
}
